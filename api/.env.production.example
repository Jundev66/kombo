# Kombo in production.
#
# Copy this file to `.env` AT THE REPOSITORY ROOT (not inside `api/`): that is
# where `docker compose -f compose.prod.yml` reads its variables from and
# passes them to the containers. There is no `.env` inside the container —
# configuration travels through the environment, which is what allows
# rebuilding the image without putting secrets back inside.
#
#   cp api/.env.production.example .env
#   $EDITOR .env
#
# The full steps are in `docs/despliegue.md`.
# ═══════════════════════════════════════════════════════════════════════════

# ── First, and nothing starts without it ───────────────────────────────────
#
# Generate it ONCE and do not lose it: it encrypts the sessions and, above
# all, the customer phone numbers stored in `customers`. Changing it makes
# that data unreadable forever.
#
#   docker run --rm dunglas/frankenphp php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
#
# or, if the project is already up:
#
#   docker compose -f compose.prod.yml run --rm api php artisan key:generate --show
APP_KEY=

# ── Your domains ────────────────────────────────────────────────────────────
#
# Each tenant lives on a subdomain: `elsazon.yourdomain.com`. A WILDCARD DNS
# record (`*`) in Cloudflare is required, with the orange cloud on. With that,
# signing a new customer up touches neither DNS, nginx nor certificates.
KOMBO_ROOT_DOMAIN=tudominio.com

# Platform administration, on its own host. Deliberately apart: `admin` is a
# reserved slug and must never fall into the tenants' wildcard.
KOMBO_ADMIN_HOST=admin.tudominio.com

# ── Database passwords ──────────────────────────────────────────────────────
#
# Two users, two different passwords, and neither is `secret`. Generate with:
#
#   openssl rand -base64 24
#
# kombo_owner is a superuser with BYPASSRLS: it only migrates. kombo_app is
# what the application talks through, and the one subject to isolation
# between tenants. If they ever become the same, isolation stops existing
# without a single test turning red.
KOMBO_OWNER_PASSWORD=
KOMBO_APP_PASSWORD=
DB_DATABASE=kombo

# ── Off-site backups ────────────────────────────────────────────────────────
#
# Optional but strongly recommended: without this the backup still runs, but
# stays on the same machine — and a backup that lives where the data lives is
# no use the day the machine is lost.
#
# Any S3-compatible storage works. Cloudflare R2 does not charge for egress,
# which is exactly what you do on the bad day. Details and how to restore are
# in `docs/respaldos.md`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_DEFAULT_REGION=auto
# For R2:  https://<account-id>.r2.cloudflarestorage.com
# For Amazon S3: leave it empty.
AWS_ENDPOINT=

# ── Logging ─────────────────────────────────────────────────────────────────
#
# `warning` and not `debug`: on a modest machine, debug-level logging writes
# constantly and competes with the database for the disk. Raise it to `info`
# for a while when chasing something, and lower it afterwards.
LOG_LEVEL=warning

# ═══════════════════════════════════════════════════════════════════════════
# What follows is NOT written here: `compose.prod.yml` already fixes it, and
# it is worth knowing why — these are the four things done wrong on deploy.
#
#   APP_DEBUG=false
#       With `true`, any error shows the customer paths, versions, queries
#       and sometimes credentials.
#
#   KOMBO_DEMO_TOOLS=false
#       CRITICAL. Switched on, `demo:clean` cancels REAL customers' orders,
#       and the seeder creates an administration account with a password
#       published in this repository.
#
#   SESSION_DOMAIN=  (empty)
#       Setting `.yourdomain.com` would make the session cookie valid on
#       EVERY subdomain: one tenant owner's session would travel to another's
#       portal. Isolation rests on the cookie belonging to one host.
#
#   SESSION_SECURE_COOKIE=true
#       The cookie only travels encrypted. Behind Cloudflare it always is.
#
# And one that is not a variable: `docker/nginx/prod.conf` recovers the
# visitor's real IP from Cloudflare's header. Without it, every customer
# shares an IP as far as the application is concerned, and the first to
# mistype a password locks everyone else out.
# ═══════════════════════════════════════════════════════════════════════════
