# Kombo en producción.
#
# Copia este fichero a `.env` EN LA RAÍZ DEL REPOSITORIO (no dentro de `api/`):
# es de ahí de donde `docker compose -f compose.prod.yml` lee las variables, y
# de ahí las pasa a los contenedores. Dentro del contenedor no hay ningún `.env`
# — la configuración va por entorno, que es lo que permite reconstruir la imagen
# sin volver a meter secretos dentro.
#
#   cp api/.env.production.example .env
#   $EDITOR .env
#
# Los pasos completos están en `docs/despliegue.md`.
# ═══════════════════════════════════════════════════════════════════════════

# ── Lo primero, y sin lo cual nada arranca ─────────────────────────────────
#
# Genérala UNA vez y no la pierdas: con ella se cifran las sesiones y, sobre
# todo, los teléfonos de los clientes guardados en `customers`. Cambiarla deja
# esos datos ilegibles para siempre.
#
#   docker run --rm dunglas/frankenphp php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
#
# o, si ya tienes el proyecto levantado:
#
#   docker compose -f compose.prod.yml run --rm api php artisan key:generate --show
APP_KEY=

# ── Tus dominios ────────────────────────────────────────────────────────────
#
# Cada negocio vive en un subdominio: `elsazon.tudominio.com`. Hace falta un
# registro DNS COMODÍN (`*`) en Cloudflare, con la nube naranja encendida. Con
# eso, dar de alta un cliente nuevo no toca ni DNS ni nginx ni certificados.
KOMBO_ROOT_DOMAIN=tudominio.com

# La super administración, en su propio host. Va aparte a propósito: `admin` es
# un slug reservado y nunca puede caer en el comodín de los negocios.
KOMBO_ADMIN_HOST=admin.tudominio.com

# ── Contraseñas de la base ──────────────────────────────────────────────────
#
# Dos usuarios, dos contraseñas distintas, y ninguna es `secret`. Genéralas con:
#
#   openssl rand -base64 24
#
# kombo_owner es superusuario y tiene BYPASSRLS: sólo migra. kombo_app es con
# el que habla la aplicación, y es el que está sujeto al aislamiento entre
# negocios. Si algún día acaban siendo la misma, el aislamiento deja de existir
# sin que ninguna prueba se ponga roja.
KOMBO_OWNER_PASSWORD=
KOMBO_APP_PASSWORD=
DB_DATABASE=kombo

# ── Respaldos fuera del servidor ────────────────────────────────────────────
#
# Opcional pero muy recomendable: sin esto el respaldo se hace igual, pero se
# queda en la misma máquina — y un respaldo que vive donde viven los datos no
# sirve el día que se pierde la máquina.
#
# Sirve cualquier almacenamiento compatible con S3. Cloudflare R2 no cobra por
# sacar los datos, que es justo lo que haces el día malo. Detalles y cómo
# restaurar, en `docs/respaldos.md`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_DEFAULT_REGION=auto
# Para R2:  https://<id-de-cuenta>.r2.cloudflarestorage.com
# Para S3 de Amazon: déjalo vacío.
AWS_ENDPOINT=

# ── Registro ────────────────────────────────────────────────────────────────
#
# `warning` y no `debug`: en una máquina modesta el registro en nivel depuración
# escribe sin parar y compite por el disco con la base de datos. Súbelo a `info`
# un rato si estás persiguiendo algo, y bájalo después.
LOG_LEVEL=warning

# ═══════════════════════════════════════════════════════════════════════════
# Lo que sigue NO se escribe aquí: `compose.prod.yml` ya lo fija, y conviene
# saber por qué, porque son las cuatro cosas que se hacen mal al desplegar.
#
#   APP_DEBUG=false
#       Con `true`, cualquier error le enseña al cliente rutas, versiones,
#       consultas y a veces credenciales.
#
#   KOMBO_DEMO_TOOLS=false
#       CRÍTICO. Encendido, el comando `demo:limpiar` cancela pedidos de
#       clientes REALES, y el seeder crea una cuenta de administración con una
#       contraseña que está publicada en este repositorio.
#
#   SESSION_DOMAIN=  (vacío)
#       Poner `.tudominio.com` haría que la cookie de sesión valiera en TODOS
#       los subdominios: la sesión del dueño de un negocio viajaría al portal de
#       otro. El aislamiento se apoya en que la cookie sea de un solo host.
#
#   SESSION_SECURE_COOKIE=true
#       La cookie sólo viaja cifrada. Con Cloudflare delante siempre lo está.
#
# Y una que no es una variable: `docker/nginx/prod.conf` recupera la IP real
# del visitante de la cabecera de Cloudflare. Sin eso, todos los clientes
# comparten IP a ojos de la aplicación y el primero que se equivoque de
# contraseña deja fuera a los demás.
# ═══════════════════════════════════════════════════════════════════════════
