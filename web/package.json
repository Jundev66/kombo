{
  "name": "kombo-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@kombo/portal --workspace=@kombo/caja --workspace=@kombo/panel --workspace=@kombo/kds --workspace=@kombo/admin",
    "typecheck": "tsc -p apps/portal && tsc -p apps/caja && tsc -p apps/panel && tsc -p apps/kds && tsc -p apps/admin",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.0",
    "vite": "^8.2.0"
  }
}
