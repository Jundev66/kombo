# La imagen de producción de la API.
#
# La diferencia de fondo con la de desarrollo: aquí **el código va DENTRO de la
# imagen**, no montado desde el disco. Una imagen que se construye una vez y se
# despliega tal cual es una imagen que se puede volver a desplegar idéntica
# mañana; una que lee el código de un directorio del servidor depende de que ese
# directorio esté como alguien lo dejó.
FROM php:8.5-fpm-trixie AS base

COPY --from=mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN install-php-extensions \
        pdo_pgsql \
        redis \
        intl \
        bcmath \
        opcache \
        zip \
        pcntl \
    && apt-get update \
    && apt-get install -y --no-install-recommends git gnupg curl ca-certificates \
    # ── El cliente de PostgreSQL 18, y por qué hace falta el repositorio ──
    #
    # Debian trixie trae el cliente 17 y el servidor es el 18. Para `psql` da
    # igual, pero `pg_dump` **se niega a volcar una base de versión superior** —
    # y sin `pg_dump` no hay respaldos. El repositorio oficial de PostgreSQL es
    # la única forma de tener el cliente 18 en Debian hoy.
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] \
        https://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Dependencias ────────────────────────────────────────────────────────────
#
# En su propia capa y ANTES de copiar el código: `composer.json` cambia una vez
# al mes y el código veinte veces al día. Al revés, cada despliegue volvería a
# descargar todo Laravel.
FROM base AS vendor

WORKDIR /var/www/api

COPY api/composer.json api/composer.lock ./

# `--no-dev`: Pest, Pint y compañía no pintan nada en un servidor, y cada
# paquete que no se usa es superficie que hay que actualizar igual.
# `--no-scripts` porque `artisan` todavía no está aquí.
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

# ── La imagen final ─────────────────────────────────────────────────────────
FROM base AS api

WORKDIR /var/www/api

COPY docker/php/php.prod.ini /usr/local/etc/php/conf.d/kombo.ini
COPY --from=vendor /var/www/api/vendor ./vendor
COPY api/ ./

# El mapa de clases completo: en producción se resuelve una vez al construir y
# no en cada petición.
RUN composer dump-autoload --optimize --classmap-authoritative \
    && chown -R www-data:www-data storage bootstrap/cache

COPY docker/php/entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

ENTRYPOINT ["entrypoint"]
CMD ["php-fpm"]
