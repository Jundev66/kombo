# What does NOT enter the build context.
#
# Both production images — the API's and the apps' — share this context, so only
# what neither of them needs is excluded here. Two entries below are security,
# not optimisation, and are marked as such.

.git/
.github/
.gitignore

# None of this is deployed.
docs/
e2e/
compose.yml
Makefile
README.md

# ── SECURITY ────────────────────────────────────────────────────────────────
# The development `.env` carries passwords and `KOMBO_DEMO_TOOLS=true`, which on
# a server leaves the order-cancelling command loose. Production configuration
# arrives through the environment; there is no `.env` inside the image.
**/.env
**/.env.*
!**/.env.production.example

# The origin certificate. Mounted from the server, never baked in.
certs/

# ── Dependencies installed on the host ──────────────────────────────────────
# The host's `api/vendor` carries Pest, Pint and every dev tool, and would
# overwrite the previous stage's `composer install --no-dev`. Same with
# node_modules: Rollup and esbuild ship per-platform binaries.
**/node_modules/
api/vendor/

# Output of earlier builds: remade inside.
**/dist/

# Local runtime state.
api/storage/logs/
api/storage/framework/cache/
api/storage/framework/sessions/
api/storage/framework/views/
# The dev machine's uploads are surplus; the FOLDERS are not. The production
# volume is seeded from whatever the image holds.
api/storage/app/public/*
!api/storage/app/public/.gitignore
api/storage/app/private/*
!api/storage/app/private/.gitignore
api/public/storage
api/bootstrap/cache/*.php
**/.phpunit.result.cache
**/.phpunit.cache/

.DS_Store
.idea/
.vscode/
api/storage/backups/
