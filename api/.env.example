APP_NAME=Kombo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Caracas
APP_URL=http://localhost:8010

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Negocios ────────────────────────────────────────────────────────────────
# El dominio raíz del que cuelgan los subdominios de cada negocio.
KOMBO_ROOT_DOMAIN=localhost
KOMBO_ADMIN_HOST=admin.localhost
KOMBO_DEMO_TOOLS=true
KOMBO_TENANT_CACHE_TTL=3600

# ── Base de datos ───────────────────────────────────────────────────────────
# La aplicación conecta como kombo_app: SIN BYPASSRLS, sujeto a las políticas
# de aislamiento igual que cualquiera. El dueño del esquema es sólo para
# migraciones: php artisan migrate --database=pgsql_owner
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kombo
DB_USERNAME=kombo_app
DB_PASSWORD=secret
DB_OWNER_USERNAME=kombo_owner
DB_OWNER_PASSWORD=secret

# ── Sesión, caché y colas ───────────────────────────────────────────────────
# SESSION_DOMAIN vacío a propósito en local: cada *.localhost es su propio
# origen, así que cerrar sesión en un negocio no afecta al otro. En producción
# va con punto inicial (.kombo.app) para valer en todos los subdominios.
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

# El comodín cubre todos los negocios presentes y futuros: dar de alta un
# cliente no toca esta línea.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8010,*.localhost,*.localhost:8010,127.0.0.1,127.0.0.1:8010

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Sanctum resuelve las dos formas de entrar: cookie de sesión para el panel y
# el portal, token bearer para la caja y la cocina. Con AUTH_GUARD=web,
# $request->user() sólo miraría la sesión y la tablet nunca estaría
# autenticada.
AUTH_GUARD=sanctum

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@kombo.app"
MAIL_FROM_NAME="${APP_NAME}"
