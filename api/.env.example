APP_NAME=Kombo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Caracas
APP_URL=http://localhost:8010

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Tenants ─────────────────────────────────────────────────────────────────
# The root domain each tenant's subdomain hangs off.
KOMBO_ROOT_DOMAIN=localhost
KOMBO_ADMIN_HOST=admin.localhost
KOMBO_DEMO_TOOLS=true
KOMBO_TENANT_CACHE_TTL=3600

# ── Database ────────────────────────────────────────────────────────────────
# The application connects as kombo_app: WITHOUT BYPASSRLS, subject to the
# isolation policies like anyone else. The schema owner is only for
# migrations: php artisan migrate --database=pgsql_owner
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kombo
DB_USERNAME=kombo_app
DB_PASSWORD=secret
DB_OWNER_USERNAME=kombo_owner
DB_OWNER_PASSWORD=secret

# ── Session, cache and queues ───────────────────────────────────────────────
# SESSION_DOMAIN is deliberately empty locally: each *.localhost is its own
# origin, so signing out of one tenant does not affect another. In production
# it takes a leading dot (.kombo.app) to hold across every subdomain.
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

# The wildcard covers every present and future tenant: signing a customer up
# does not touch this line.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8010,*.localhost,*.localhost:8010,127.0.0.1,127.0.0.1:8010

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Sanctum handles both ways in: a session cookie for the dashboard and the
# portal, a bearer token for the till and the kitchen. With AUTH_GUARD=web,
# $request->user() would only look at the session and the tablet would never
# be authenticated.
AUTH_GUARD=sanctum

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@kombo.app"
MAIL_FROM_NAME="${APP_NAME}"
